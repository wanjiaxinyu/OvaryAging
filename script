RunSeurat <- function(obj, n = 4, dc, np,  resol, spli, intemethod = RPCAIntegration) {
  DefaultAssay(obj) <- "decontXcounts"
  obj[["decontXcounts"]] <- split(obj[["decontXcounts"]], f = obj@meta.data[[spli]])
  plan("multicore", workers = n)
  obj <- NormalizeData(obj)
  VariableFeatures(obj) <- consensus_features
  obj <- ScaleData(obj)
  plan("sequential")
  obj <- RunPCA(obj,npcs = np)
  plan("multicore", workers = n)
  redution_name <- paste0(deparse(substitute(intemethod)), "_", spli)
  obj <- IntegrateLayers(object = obj, method = intemethod, orig.reduction = "pca",
      new.reduction = redution_name, verbose = FALSE)
  plan("sequential")
  obj <- JoinLayers(obj)
  obj <- FindNeighbors(obj, reduction = redution_name, dims = 1:np)
  obj <- FindClusters(obj, resolution = resol, cluster.name = paste0(redution_name, "_", deparse(substitute(resol)), "_", deparse(substitute(np)), "_clusters"))
  obj <- RunUMAP(obj, reduction = redution_name, reduction.name = paste0("umap.", redution_name),dims = 1:np)
  plan("sequential")
  return(obj)
}



cell_key <- paste(ovary_sce$Donor, ovary_sce[[ob_group]], sep = "___CELLTYPE___")
ovary_sce$nCells <- as.numeric(table(cell_key)[cell_key])

pb <- dreamlet::aggregateToPseudoBulk(
  ovary_sce,
  assay = "counts", cluster_id = ob_group, sample_id = "Donor",
  verbose = TRUE
)
pb$Age <- suppressWarnings(as.numeric(as.character(pb$Age)))
pb$data_source <- droplevels(factor(as.character(pb$data_source)))

pb$Age10 <- (pb$Age - mean(pb$Age)) / 10


derive_hidden_pc1 <- function(pb, min_count, min_prop) {
  full_counts <- Reduce(`+`, lapply(assayNames(pb), function(ct) assay(pb, ct)))
  meta <- as.data.frame(colData(pb))
  donor_ids <- if ("Donor" %in% names(meta)) as.character(meta$Donor) else rownames(meta)
  idx <- match(colnames(full_counts), donor_ids)
  meta <- meta[idx, , drop = FALSE]
  rownames(meta) <- colnames(full_counts)

  keep_gene <- Matrix::rowSums(full_counts >= min_count) >=
    ceiling(min_prop * ncol(full_counts))

  design_known <- model.matrix(~ Age10 + data_source, data = meta)
  if (qr(design_known)$rank < ncol(design_known)) {
    stop("Age10 + data_source design matrix is rank-deficient")
  }

  dge_full <- edgeR::DGEList(counts = as.matrix(full_counts[keep_gene, , drop = FALSE]))
  dge_full <- edgeR::calcNormFactors(dge_full, method = "TMM")
  voom_full <- limma::voom(dge_full, design = design_known, plot = FALSE)


  expression_corrected <- limma::removeBatchEffect(
    voom_full,
    covariates = design_known[, colnames(design_known) != "(Intercept)", drop = FALSE]
  )
  pca_fit <- prcomp(t(expression_corrected), center = TRUE, scale. = FALSE)
  list(
    PC1 = pca_fit$x[, "PC1"],
    PC1_variance = pca_fit$sdev[1]^2 / sum(pca_fit$sdev^2),
    pca = pca_fit, metadata = meta, n_genes = sum(keep_gene)
  )
}

pc1_result <- derive_hidden_pc1(pb, min_count, min_prop)
pb_meta <- as.data.frame(colData(pb))
pb_donor <- if ("Donor" %in% names(pb_meta)) as.character(pb_meta$Donor) else rownames(pb_meta)
idx_pc1 <- match(pb_donor, names(pc1_result$PC1))

pb$PC1_hidden <- unname(pc1_result$PC1[idx_pc1])
stopifnot(length(pb$PC1_hidden) == ncol(pb), !anyNA(pb$PC1_hidden))



form_pc1 <- ~ Age10 + data_source + PC1_hidden
design_pc1 <- model.matrix(form_pc1, data = as.data.frame(colData(pb)))
if (qr(design_pc1)$rank < ncol(design_pc1)) {
  stop("Age10 + data_source + PC1_hidden design matrix is rank-deficient")
}
bp <- BiocParallel::MulticoreParam(workers = 8, progressbar = TRUE)

res.proc_pc1 <- dreamlet::processAssays(
  pb, formula = form_pc1,
  min.cells, min.count, min.samples, min.prop,
  normalize.method = "TMM", BPPARAM = bp
)
fit_age_pc1 <- dreamlet::dreamlet(res.proc_pc1, formula = form_pc1, BPPARAM = bp)
age_result_pc1 <- as.data.frame(dreamlet::topTable(
  fit_age_pc1, coef = "Age10", number = Inf,
  adjust.method = "BH", sort.by = "none"
))



