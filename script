library(Seurat)
library(ggplot2)
library(dplyr)
library(forcats)

RunSeurat <- function(obj, n = 4, dc, np,  resol, spli, intemethod = RPCAIntegration) {
  DefaultAssay(obj) <- "decontXcounts"
  obj[["decontXcounts"]] <- split(obj[["decontXcounts"]], f = obj@meta.data[[spli]])
  plan("multicore", workers = n)
  obj <- NormalizeData(obj)
  VariableFeatures(obj) <- consensus_features
  obj <- ScaleData(obj)
  plan("sequential")
  obj <- RunPCA(obj,npcs = np)
  plan("multicore", workers = n)
  redution_name <- paste0(deparse(substitute(intemethod)), "_", spli)
  obj <- IntegrateLayers(object = obj, method = intemethod, orig.reduction = "pca",
      new.reduction = redution_name, verbose = FALSE)
  plan("sequential")
  obj <- JoinLayers(obj)
  obj <- FindNeighbors(obj, reduction = redution_name, dims = 1:np)
  obj <- FindClusters(obj, resolution = resol, cluster.name = paste0(redution_name, "_", deparse(substitute(resol)), "_", deparse(substitute(np)), "_clusters"))
  obj <- RunUMAP(obj, reduction = redution_name, reduction.name = paste0("umap.", redution_name),dims = 1:np)
  plan("sequential")
  return(obj)
}


